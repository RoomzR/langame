<Window x:Class="Rudemir.GuestClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RUDEMIR Guest"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        Topmost="True"
        Background="{StaticResource Void}"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="76"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="52"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource Velvet}" BorderBrush="{StaticResource Gold}" BorderThickness="0,0,0,1">
            <Grid Margin="28,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="RUDEMIR" FontSize="24" FontWeight="Bold" Foreground="{StaticResource Gold}"/>
                    <TextBlock x:Name="ClubLabel" Margin="20,0,0,0" FontSize="15" VerticalAlignment="Center"/>
                    <TextBlock x:Name="SeatLabel" Margin="12,0,0,0" FontSize="15" Foreground="{StaticResource Mute}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,28,0">
                        <TextBlock Text="Гость" FontSize="11" Foreground="{StaticResource Mute}"/>
                        <TextBlock x:Name="UserLabel" FontSize="16" Foreground="{StaticResource Paper}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,28,0">
                        <TextBlock Text="Баланс" FontSize="11" Foreground="{StaticResource Mute}"/>
                        <TextBlock x:Name="BalanceLabel" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Free}"/>
                    </StackPanel>
                    <Button Content="Выйти" Style="{StaticResource Ghost}" Height="36" Click="Logout_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Body -->
        <Grid Grid.Row="1" Margin="28,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.1*"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Launcher -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="Игры и программы" FontSize="20" Foreground="{StaticResource Paper}" FontWeight="SemiBold"/>
                    <TextBlock x:Name="AppsHint" Margin="14,4,0,0" Foreground="{StaticResource Mute}" Text="нажмите, чтобы запустить"/>
                </StackPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <WrapPanel x:Name="AppsPanel" ItemWidth="172" ItemHeight="132"/>
                </ScrollViewer>
                <Border Grid.Row="2" Background="{StaticResource Velvet}" CornerRadius="4" Padding="16" Margin="0,16,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Сообщения администратора" FontSize="12" Foreground="{StaticResource Mute}"/>
                            <ItemsControl x:Name="ChatList" Margin="0,6,0,0" MaxHeight="90">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                            <TextBox x:Name="ChatBox" Width="260" Margin="0,0,8,0"/>
                            <Button Content="Написать" Style="{StaticResource Ghost}" Height="44" Click="Chat_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Session panel -->
            <Border Grid.Column="2" Background="{StaticResource Velvet}" CornerRadius="6" Padding="22">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Ваша сессия" FontSize="12" Foreground="{StaticResource Mute}"/>
                        <TextBlock x:Name="TimerLabel" Text="--:--:--" FontSize="52" FontWeight="Bold" Foreground="{StaticResource Paper}" Margin="0,4,0,0"/>
                        <TextBlock x:Name="TimerHint" Foreground="{StaticResource Mute}" Text="ожидание запуска администратором"/>
                        <TextBlock x:Name="TariffLabel" Margin="0,8,0,0"/>
                        <TextBlock x:Name="ChargedLabel" Foreground="{StaticResource Mute}"/>

                        <Border Background="{StaticResource Paper}" CornerRadius="4" Padding="14" Margin="0,20,0,0">
                            <StackPanel>
                                <TextBlock Text="Пополнить баланс" Foreground="{StaticResource Void}" FontWeight="SemiBold"/>
                                <TextBlock Text="Карта bePaid или ЕРИП, зачисление сразу" Foreground="#80110A20" FontSize="12"/>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <TextBox x:Name="TopupBox" Text="10" Width="72" Background="White" Foreground="{StaticResource Void}" BorderBrush="#33000000"/>
                                    <TextBlock Text="Br" Foreground="{StaticResource Void}" VerticalAlignment="Center" Margin="8,0,12,0"/>
                                    <Button Content="Оплатить" Style="{StaticResource Primary}" Height="44" Click="Topup_Click"/>
                                </StackPanel>
                                <TextBlock x:Name="TopupHint" Foreground="#B0110A20" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <Button Content="Вызвать администратора" Style="{StaticResource GoldBtn}" Margin="0,18,0,0" Click="CallAdmin_Click"/>

                        <TextBlock Text="Бар к месту" FontSize="12" Foreground="{StaticResource Mute}" Margin="0,20,0,0"/>
                        <ComboBox x:Name="ProductBox" Margin="0,6,0,8"/>
                        <Button Content="Заказать" Style="{StaticResource Ghost}" Click="Order_Click"/>

                        <TextBlock x:Name="StatusLabel" Foreground="{StaticResource Gold}" TextWrapping="Wrap" Margin="0,18,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" Background="{StaticResource Velvet}">
            <Grid Margin="28,0">
                <TextBlock x:Name="ClockLabel" VerticalAlignment="Center" Foreground="{StaticResource Mute}"/>
                <TextBlock VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{StaticResource Mute}"
                           Text="Ctrl+Shift+Q — сервисный выход"/>
            </Grid>
        </Border>

        <!-- Lock overlay -->
        <Border x:Name="LockOverlay" Grid.RowSpan="3" Background="#F20A0810" Visibility="Visible">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="440"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="RUDEMIR" FontSize="40" FontWeight="Bold" Foreground="{StaticResource Gold}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="LockTitle" Text="ПК заблокирован" FontSize="22" Foreground="{StaticResource Paper}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    <TextBlock x:Name="LockSubtitle" Text="Войдите, чтобы начать играть. Баланс и брони общие для всех клубов сети." Foreground="{StaticResource Mute}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,24"/>

                    <Border Background="{StaticResource Velvet}" CornerRadius="6" Padding="22">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <Button x:Name="TabPhone" Content="Телефон" Style="{StaticResource GoldBtn}" Height="36" Width="120" Click="TabPhone_Click"/>
                                <Button x:Name="TabCard" Content="Карта гостя" Style="{StaticResource Ghost}" Height="36" Width="120" Margin="8,0,0,0" Click="TabCard_Click"/>
                            </StackPanel>
                            <StackPanel x:Name="PhonePane">
                                <TextBlock Text="Телефон" FontSize="12" Foreground="{StaticResource Mute}"/>
                                <TextBox x:Name="PhoneBox" Text="+375291000004" Margin="0,4,0,10"/>
                                <TextBlock Text="Пароль" FontSize="12" Foreground="{StaticResource Mute}"/>
                                <PasswordBox x:Name="PasswordBox" Margin="0,4,0,14"/>
                                <Button Content="Войти" Style="{StaticResource Primary}" Click="Login_Click"/>
                            </StackPanel>
                            <StackPanel x:Name="CardPane" Visibility="Collapsed">
                                <TextBlock Text="Номер карты" FontSize="12" Foreground="{StaticResource Mute}"/>
                                <TextBox x:Name="CardBox" Text="10000004" Margin="0,4,0,10"/>
                                <TextBlock Text="PIN" FontSize="12" Foreground="{StaticResource Mute}"/>
                                <PasswordBox x:Name="PinBox" Margin="0,4,0,14"/>
                                <Button Content="Войти по карте" Style="{StaticResource Primary}" Click="CardLogin_Click"/>
                            </StackPanel>
                            <TextBlock x:Name="LoginError" Foreground="{StaticResource Busy}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Expander x:Name="SetupExpander" Header="Настройка места (сервис)" Foreground="{StaticResource Mute}" Margin="0,18,0,0">
                        <StackPanel Margin="0,8,0,0">
                            <TextBox x:Name="SetupClubBox" ToolTip="Club UUID или slug" Margin="0,4"/>
                            <TextBox x:Name="SetupSeatBox" ToolTip="Seat UUID" Margin="0,4"/>
                            <TextBlock Text="Значения сохраняются в appsettings.json при входе." FontSize="11" Foreground="{StaticResource Mute}"/>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
