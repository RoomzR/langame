<Application x:Class="Rudemir.GuestClient.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="Void" Color="#0A0810"/>
        <SolidColorBrush x:Key="Velvet" Color="#1A1230"/>
        <SolidColorBrush x:Key="VelvetDeep" Color="#120C22"/>
        <SolidColorBrush x:Key="Fog" Color="#D4CDE0"/>
        <SolidColorBrush x:Key="Mute" Color="#8B829C"/>
        <SolidColorBrush x:Key="Paper" Color="#F4EFE3"/>
        <SolidColorBrush x:Key="Gold" Color="#E0B84A"/>
        <SolidColorBrush x:Key="Signal" Color="#FF3D7F"/>
        <SolidColorBrush x:Key="Free" Color="#3DDC97"/>
        <SolidColorBrush x:Key="Busy" Color="#FF6B6B"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Fog}"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
        </Style>

        <Style x:Key="Field" TargetType="Control">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{StaticResource VelvetDeep}"/>
            <Setter Property="Foreground" Value="{StaticResource Paper}"/>
            <Setter Property="BorderBrush" Value="#33FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource Field}">
            <Setter Property="CaretBrush" Value="{StaticResource Gold}"/>
        </Style>
        <Style TargetType="PasswordBox" BasedOn="{StaticResource Field}"/>
        <Style TargetType="ComboBox" BasedOn="{StaticResource Field}"/>

        <Style x:Key="Primary" TargetType="Button">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Background" Value="{StaticResource Signal}"/>
            <Setter Property="Foreground" Value="{StaticResource Void}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="16,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GoldBtn" TargetType="Button" BasedOn="{StaticResource Primary}">
            <Setter Property="Background" Value="{StaticResource Gold}"/>
        </Style>
        <Style x:Key="Ghost" TargetType="Button" BasedOn="{StaticResource Primary}">
            <Setter Property="Background" Value="#22FFFFFF"/>
            <Setter Property="Foreground" Value="{StaticResource Fog}"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>
        <Style x:Key="Tile" TargetType="Button" BasedOn="{StaticResource Primary}">
            <Setter Property="Background" Value="{StaticResource Velvet}"/>
            <Setter Property="Foreground" Value="{StaticResource Paper}"/>
            <Setter Property="Height" Value="Auto"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>
    </Application.Resources>
</Application>
