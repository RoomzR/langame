{
  "name": "rudemir",
  "private": true,
  "version": "0.1.0",
  "description": "RUDEMIR — платформа управления киберклубами Беларуси",
  "workspaces": [
    "backend",
    "shared/types",
    "shared/sdk",
    "web-aggregator"
  ],
  "scripts": {
    "dev:api": "npm run start:dev -w backend",
    "dev:web": "npm run dev -w web-aggregator",
    "db:up": "docker compose up -d postgres redis",
    "db:migrate": "npm run prisma:migrate -w backend",
    "db:seed": "npm run prisma:seed -w backend",
    "db:reset": "npm run prisma:reset -w backend",
    "test:api": "npm run test:e2e -w backend"
  },
  "engines": {
    "node": ">=20"
  }
}
